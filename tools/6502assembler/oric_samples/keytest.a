!to "keytest.tap"

; Graphics
; tiles/text map
REG_TEXTMAP_L1    = $bb80
REG_TILEMAP_L1    = $c800
REG_TILEMAP_L0    = $d000


; tile id 0-255 in 8x8   tile mode
; tile id 0-63  in 16x16 tile mode

; sprites (96 max) in L2
NB_SPRITES_MAX    = 96

REG_SPRITE_IND    = $d800
REG_SPRITE_XHI    = $d880
REG_SPRITE_XLO    = $d900
REG_SPRITE_Y      = $d980
; id:    0-5 (max 63)
; hflip: 6
; vflip: 7

; mode
REG_VIDEO_MODE    = $db00
; 0-1: resolution (0=640x200,1=320x200,2=256x200)

; bg/text color
REG_BG_COL        = $db01
; RGB332
REG_FG_COL        = $db0d
; RGB332
; R: 5-7, 0x20 -> 0xe0   xxx --- --
; G: 2-4, 0x04 -> 0x1c   --- xxx -- 
; B: 0-1, 0x00 -> 0x03   --- --- xx  

; layers config
REG_LAYERS_CFG    = $db02
; 0: L0 on/off (1=on)
; 1: L1 on/off (1=on)    (off if HIRES and bitmap in L0!)
; 2: L2 on/off (1=on)
; 3: L2 inbetween (0 = sprites top)
; 4: bitmap/tile in L0 (0=bitmap)
; 5: petfont/tile in L1 (0=petfont)
; 6: enable scroll area in L0
; 7: enable scroll area in L1

; tiles config
REG_TILES_CFG     = $db0e
; 0: L0: 0=8x8, 1=16x16
; 1: L1: 0=8x8, 1=16x16
; 2-4: xcurtain
;      0: on/off
;      1: 8/16 pixels left
; 5-7: ycurtain
;      0: on/off
;      1: 8/16 pixels top

; lines config
REG_LINES_CFG     = $db03
; 0: single/perline background color
; 1: single/perline L0 xscroll
; 2: single/perline L1 xscroll

; layer scroll
REG_XSCROLL_HI    = $db04
; 3-0: L0 xscroll HI
; 7-4: L1 xscroll HI
REG_XSCROLL_L0    = $db05
REG_XSCROLL_L1    = $db06
REG_YSCROLL_L0    = $db07
REG_YSCROLL_L1    = $db08
; 7-0, in pixels
; scroll area
REG_SC_START_L0   = $db09
REG_SC_END_L0     = $db0a
REG_SC_START_L1   = $db0b
REG_SC_END_L1     = $db0c
; 4-0, in tiles/characters


; vsync line (0-200, 200 is overscan) (RD)
REG_VSYNC         = $db0f
;
; data transfer
REG_TLOOKUP       = $da00
; used as RGB332 LUT for pixels (palette) (WR)
; also used as 256 scratch buffer for other commands (WR/RD) 

REG_TDEPTH        = $db10
; WR
; 1/2/4/8 bits per pixel (using indexed CLUT)
; 9 = 8 bits RGB332 no CLUT
; 0 = compressed

REG_TCOMMAND      = $db11
; WR
; 0: idle
; 1: transfer tiles data      (data=tilenr,w,h,packet pixels)
; 2: transfer sprites data    (data=spritenr,w,h,packet pixels)
; 3: transfer bitmap data     (data=xh,xl,y,wh,wl,h,w*h/packet pixels) 
; 4: transfer t/fmap col data (data=layer,col,row,size,size/packet tiles)
; 5: transfer t/fmap row data (data=layer,col,row,size,size/packet tiles)
; 6: transfer all tile 8bits data compressed (data=sizeh,sizel,pixels)
; 7: transfer all sprite 8bits data compressed (data=sizeh,sizel,pixels)
; 8: transfer bitmap 8bits data compressed (data=sizeh,sizel,pixels)
; 9: transfer font 1bit data, 8bits a time (data=sizeh,sizel,pixels)  

REG_TPARAMS       = $db12
; WR

REG_TDATA         = $db13
; WR

REG_TSTATUS       = $db14
; transfer status (RD) 1=ready for async commands only

; Redefining tiles/sprite sequence
; 1. write lookup palette entries needed
; 2. write transfer mode (1/2/4/8/9)
; 3. write command 1/2
; 4. write params tile/sprite id,w,h
; 5. write data sequence (8bytes*plane for tiles, (h*2)bytes*plane for sprites)
; (any new command to reset)
;
; Transfer bitmap sequence
; 1. write lookup palette entries needed
; 2. write transfer mode (1/2/4/8/9)
; 3. write command 3
; 4. write params XH,XL,Y,WH,WL,H
; 5. write data sequence (bytes*plane /packed_bits)
; (any new command to reset)

; lines background color / scroll (200 values)
REG_LINES_BG_COL  = $db38
; RGB332
REG_LINES_XSCR_HI = $dc00
; 7-4:  lines L1 xscroll hi, 3-0: L0 xscroll hi
REG_LINES_L0_XSCR = $dcc8
REG_LINES_L1_XSCR = $dd90
;
; Sprite collision
; only for first 16 sprites against all the rest (96) 
; LO (8bits x 96 entries, first 8 sprites, bit0 = sprite 0) 
; HI (8bits x 96 entries, last  8 sprites, bit0 = sprite 8)
REG_SPRITE_COL_LO = $df00 
REG_SPRITE_COL_HI = $df80
;
; Audio
; SID (see C64)
REG_SIDBASE       = $df00

REG_HYPGFXENA     = $db16


; Joystick macros
JOY_UP            = (1)
JOY_DOWN          = (2)
JOY_FIRE          = (4)
JOY_LEFT          = (8)
JOY_RIGHT         = (16) 



*= $0ff0

!byte $16
!byte $16
!byte $16
!byte $16
!byte $24

!byte $00
!byte $00

!byte $80 ; type
!byte $c7 ; autorun
!byte >prgend
!byte <prgend
!byte >prgstart
!byte <prgstart
!byte $00

!byte $41
!byte $00

*= $1000
prgstart:

        jmp start       


start:
        LDA #1
        STA REG_HYPGFXENA
        sei
        jsr init_keyboard       ; init keyboard routine

        
loop:

wait_vsync:
        lda REG_VSYNC
        cmp #200
        bne wait_vsync

waiy_vsyncend:        
        lda REG_VSYNC
        cmp #200
        beq waiy_vsyncend

        jsr read_key
        ; jsr read_col0
        ; jsr wait_space
        sta REG_TEXTMAP_L1+8
        cmp #' '
        beq exit
        jmp loop

exit:
        LDA #0                  ; Disable HyperGFX
        STA REG_HYPGFXENA
        CLI
        JMP ($FFFA)  ; Warm Start
;        JMP ($FFFC)  ; Cold Start      
;        rts 

;-------------------------------------------------------------
; Oric-1 / Atmos Keyboard Scanning Routine
; Hardware addresses

VIA_DDRA    = $0303    ; Data Direction Register A
VIA_DDRB    = $0302
VIA_PORTB   = $0300 
VIA_PORTA   = $030f
VIA_PCR     = $030C    ; Peripheral Control Register

;Row \ Col       PA0 ($FE)       PA1 ($FD)       PA2 ($FB)       PA3 ($F7)       PA4 ($EF)       PA5 ($DF)       PA6 ($BF)       PA7 ($7F)
;(0)             7               N               5               V               R-CTRL          1               X               3
;(1)             J               T               R               F               ESC             Q               D               (unassigned)
;(2)             M               6               B               4               CTRL            Z               2               C
;(3)             K               9               ;               -               <               \               '               (unassigned)
;(4)             SPACE           ,               .               ↑ (Up)          L-SHIFT         ← (Left)        ↓ (Down)        → (Right)
;(5)             U               I               O               P               FUNCT           DEL             ]               [
;(6)             Y               H               G               E               ALTGR*          A               S               W
;(7)             8               L               0               /               R-SHIFT         RETURN          CAPS            =

kcol0: !byte '7','J','M','K',' ','U','Y','8',$fe
kcol1: !byte 'N','T','6','9',',','I','H','L',$fd
kcol2: !byte '5','R','B',';','.','O','G','0',$fb
kcol3: !byte 'V','F','4','-', 0, 'P','E','/',$f7
kcol4: !byte  0,  0,  0, '<', 0,  0,  0,  0 ,$ef
kcol5: !byte '1','Q','Z','\', 0,  0, 'A', 13,$df
kcol6: !byte 'X','D','2',"'", 0, ']','S', 0 ,$bf
kcol7: !byte '3', 0, 'C', 0,  0, '[','W','=',$7f
pkey: !byte 0

init_keyboard:
        lda #$07                ; PB0, PB1, PB2 = output (1), PB3 = input (0)
        sta VIA_DDRB
        lda #$ff                ; PB0-7  output (1)
        sta VIA_DDRA
        rts

read_col0:
        ldx #8
        jmp read_key

read_akey:
        ldx #(9*8-1)
k0:
        lda #14                 ; Write Column Register Number to PortA
        sta VIA_PORTA 
        ldy #$ff                ; Tell AY this is Register Number
        sty VIA_PCR            
        ldy #$dd                ; Clear CB2, as keeping it high hangs on some orics.
        sty VIA_PCR             ; Pitty, as all this code could be run only once, otherwise
        ldy #8                       
        lda kcol0,x             ; Write column mask to Port A(negative logic)
        sta VIA_PORTA
k1:     dex 
        dey
        tya
        bmi k2                  ; Select row on VIA Port B (bits 0-2)  
        sta VIA_PORTB
        lda #$fd
        sta VIA_PCR
        sty VIA_PCR
        lda VIA_PORTB           ; Read VIA Port B
        and #$08                ; Test bit 3 (PB3)
        beq k1                  ; next row
        lda kcol0,x
        rts
k2:     txa
        bne k0                  ; next column
        lda #0
        rts

read_key:
        jsr read_akey
        cmp pkey
        beq read_key
        sta pkey
        rts 


wait_space:
        lda #14                 ; Write Column Register Number to PortA
        sta VIA_PORTA 
        ldy #$ff                ; Tell AY this is Register Number
        sty VIA_PCR            
        ldy #$dd                ; Clear CB2, as keeping it high hangs on some orics.
        sty VIA_PCR             ; Pitty, as all this code could be run only once, otherwise
        ldy #8                       
        lda #$fe                ; Write column mask to Port A(negative logic)
        sta VIA_PORTA
        lda #4                  ; Select row on VIA Port B (bits 0-2) 
        sta VIA_PORTB
        lda #$fd
        sta VIA_PCR
        sty VIA_PCR
        lda VIA_PORTB           ; Read VIA Port B
        and #$08                ; Test bit 3 (PB3)
        beq k3                  ; not pressed!
        lda #' ' 
        rts
k3:     lda #0
        rts

prgend:
!byte $00

