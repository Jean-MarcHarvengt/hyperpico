!to "spranim.tap"

; Graphics
; tiles/text map
REG_TEXTMAP_L1    = $bb80
REG_TILEMAP_L1    = $c800
REG_TILEMAP_L0    = $d000
; tile id 0-255 in 8x8   tile mode
; tile id 0-63  in 16x16 tile mode

; sprites (96 max) in L2
NB_SPRITES_MAX    = 96

REG_SPRITE_IND    = $d800
REG_SPRITE_XHI    = $d880
REG_SPRITE_XLO    = $d900
REG_SPRITE_Y      = $d980
; id:    0-5 (max 63)
; hflip: 6
; vflip: 7

; mode
REG_VIDEO_MODE    = $db00
; 0-1: resolution (0=640x200,1=320x200,2=256x200)

; bg/text color
REG_BG_COL        = $db01
; RGB332
REG_FG_COL        = $db0d
; RGB332
; R: 5-7, 0x20 -> 0xe0   xxx --- --
; G: 2-4, 0x04 -> 0x1c   --- xxx -- 
; B: 0-1, 0x00 -> 0x03   --- --- xx  

; layers config
REG_LAYERS_CFG    = $db02
; 0: L0 on/off (1=on)
; 1: L1 on/off (1=on)    (off if HIRES and bitmap in L0!)
; 2: L2 on/off (1=on)
; 3: L2 inbetween (0 = sprites top)
; 4: bitmap/tile in L0 (0=bitmap)
; 5: petfont/tile in L1 (0=petfont)
; 6: enable scroll area in L0
; 7: enable scroll area in L1

; tiles config
REG_TILES_CFG     = $db0e
; 0: L0: 0=8x8, 1=16x16
; 1: L1: 0=8x8, 1=16x16
; 2-4: xcurtain
;      0: on/off
;      1: 8/16 pixels left
; 5-7: ycurtain
;      0: on/off
;      1: 8/16 pixels top

; lines config
REG_LINES_CFG     = $db03
; 0: single/perline background color
; 1: single/perline L0 xscroll
; 2: single/perline L1 xscroll

; layer scroll
REG_XSCROLL_HI    = $db04
; 3-0: L0 xscroll HI
; 7-4: L1 xscroll HI
REG_XSCROLL_L0    = $db05
REG_XSCROLL_L1    = $db06
REG_YSCROLL_L0    = $db07
REG_YSCROLL_L1    = $db08
; 7-0, in pixels
; scroll area
REG_SC_START_L0   = $db09
REG_SC_END_L0     = $db0a
REG_SC_START_L1   = $db0b
REG_SC_END_L1     = $db0c
; 4-0, in tiles/characters


; vsync line (0-200, 200 is overscan) (RD)
REG_VSYNC         = $db0f
;
; data transfer
REG_TLOOKUP       = $da00
; used as RGB332 LUT for pixels (palette) (WR)
; also used as 256 scratch buffer for other commands (WR/RD) 

REG_TDEPTH        = $db10
; WR
; 1/2/4/8 bits per pixel (using indexed CLUT)
; 9 = 8 bits RGB332 no CLUT
; 0 = compressed

REG_TCOMMAND      = $db11
; WR
; 0: idle
; 1: transfer tiles data      (data=tilenr,w,h,packet pixels)
; 2: transfer sprites data    (data=spritenr,w,h,packet pixels)
; 3: transfer bitmap data     (data=xh,xl,y,wh,wl,h,w*h/packet pixels) 
; 4: transfer t/fmap col data (data=layer,col,row,size,size/packet tiles)
; 5: transfer t/fmap row data (data=layer,col,row,size,size/packet tiles)
; 6: transfer all tile 8bits data compressed (data=sizeh,sizel,pixels)
; 7: transfer all sprite 8bits data compressed (data=sizeh,sizel,pixels)
; 8: transfer bitmap 8bits data compressed (data=sizeh,sizel,pixels)
; 9: transfer font 1bit data, 8bits a time (data=sizeh,sizel,pixels)  

REG_TPARAMS       = $db12
; WR

REG_TDATA         = $db13
; WR

REG_TSTATUS       = $db14
; transfer status (RD) 1=ready for async commands only

; Redefining tiles/sprite sequence
; 1. write lookup palette entries needed
; 2. write transfer mode (1/2/4/8/9)
; 3. write command 1/2
; 4. write params tile/sprite id,w,h
; 5. write data sequence (8bytes*plane for tiles, (h*2)bytes*plane for sprites)
; (any new command to reset)
;
; Transfer bitmap sequence
; 1. write lookup palette entries needed
; 2. write transfer mode (1/2/4/8/9)
; 3. write command 3
; 4. write params XH,XL,Y,WH,WL,H
; 5. write data sequence (bytes*plane /packed_bits)
; (any new command to reset)

; lines background color / scroll (200 values)
REG_LINES_BG_COL  = $db38
; RGB332
REG_LINES_XSCR_HI = $dc00
; 7-4:  lines L1 xscroll hi, 3-0: L0 xscroll hi
REG_LINES_L0_XSCR = $dcc8
REG_LINES_L1_XSCR = $dd90
;
; Sprite collision
; only for first 16 sprites against all the rest (96) 
; LO (8bits x 96 entries, first 8 sprites, bit0 = sprite 0) 
; HI (8bits x 96 entries, last  8 sprites, bit0 = sprite 8)
REG_SPRITE_COL_LO = $df00 
REG_SPRITE_COL_HI = $df80
;
; Audio
; SID (see C64)
REG_SIDBASE       = $df00

REG_HYPGFXENA     = $db16


; Joystick macros
JOY_UP            = (1)
JOY_DOWN          = (2)
JOY_FIRE          = (4)
JOY_LEFT          = (8)
JOY_RIGHT         = (16) 

NB_SPRITES_TOTAL = 96
NB_SPRITES       = 32


*= $0ff0

!byte $16
!byte $16
!byte $16
!byte $16
!byte $24

!byte $00
!byte $00

!byte $80 ; type
!byte $c7 ; autorun
!byte >prgend
!byte <prgend
!byte >prgstart
!byte <prgstart
!byte $00

!byte $41
!byte $00

*= $1000
prgstart:

        jmp start        


start:
        LDA #1                  ; Enable HyperGFX
        STA REG_HYPGFXENA
        sei                     ; Disable interrupts
        jsr init_keyboard       ; init keyboard routine

;        lda #2                  ; 256x200 (32x25)
;        sta REG_VIDEO_MODE
        lda #4+2+1
        sta REG_LAYERS_CFG
       
        ldy #NB_SPRITES_TOTAL-1 ; NR sprites available
-
        lda #$00
        sta REG_SPRITE_IND,y
        sta REG_SPRITE_XHI,y
        sta REG_SPRITE_XLO,y
        lda #200
        sta REG_SPRITE_Y,y
        dey
        bpl -

        lda #9                   ; transfer sprite: 8 bits no clut
        sta REG_TDEPTH
        ldx #$00
        lda #<sprite_mario
        sta $54
        lda #>sprite_mario
        sta $55
        jsr sprite8bits


loop: 

wait_vsync:
        lda REG_VSYNC
        cmp #200
        bne wait_vsync

        jsr vsynctask

waiy_vsyncend:        
        lda REG_VSYNC
        cmp #200
        beq waiy_vsyncend

        ; jsr read_key
        ; jsr read_col0
        jsr wait_space
        cmp #' '
        beq exit
        jmp loop

exit:
        
        lda #$07                ; Petfont + bitmap + no sprites
        sta REG_LAYERS_CFG
        lda #1                  ; 320x200
        sta REG_VIDEO_MODE
        jsr spriteshide

        LDA #0                  ; Disable HyperGFX
        STA REG_HYPGFXENA
        CLI
        JMP ($FFFA)  ; Warm Start
;        JMP ($FFFC)  ; Cold Start      
;        rts 

;-------------------------------------------------------------
; Oric-1 / Atmos Keyboard Scanning Routine
; Hardware addresses

VIA_DDRA    = $0303    ; Data Direction Register A
VIA_DDRB    = $0302
VIA_PORTB   = $0300 
VIA_PORTA   = $030f
VIA_PCR     = $030C    ; Peripheral Control Register

;Row \ Col       PA0 ($FE)       PA1 ($FD)       PA2 ($FB)       PA3 ($F7)       PA4 ($EF)       PA5 ($DF)       PA6 ($BF)       PA7 ($7F)
;(0)             7               N               5               V               R-CTRL          1               X               3
;(1)             J               T               R               F               ESC             Q               D               (unassigned)
;(2)             M               6               B               4               CTRL            Z               2               C
;(3)             K               9               ;               -               <               \               '               (unassigned)
;(4)             SPACE           ,               .               ↑ (Up)          L-SHIFT         ← (Left)        ↓ (Down)        → (Right)
;(5)             U               I               O               P               FUNCT           DEL             ]               [
;(6)             Y               H               G               E               ALTGR*          A               S               W
;(7)             8               L               0               /               R-SHIFT         RETURN          CAPS            =

kcol0: !byte '7','J','M','K',' ','U','Y','8',$fe
kcol1: !byte 'N','T','6','9',',','I','H','L',$fd
kcol2: !byte '5','R','B',';','.','O','G','0',$fb
kcol3: !byte 'V','F','4','-', 0, 'P','E','/',$f7
kcol4: !byte  0,  0,  0, '<', 0,  0,  0,  0 ,$ef
kcol5: !byte '1','Q','Z','\', 0,  0, 'A', 13,$df
kcol6: !byte 'X','D','2',"'", 0, ']','S', 0 ,$bf
kcol7: !byte '3', 0, 'C', 0,  0, '[','W','=',$7f
pkey: !byte 0

init_keyboard:
        lda #$07                ; PB0, PB1, PB2 = output (1), PB3 = input (0)
        sta VIA_DDRB
        lda #$ff                ; PB0-7  output (1)
        sta VIA_DDRA
        rts

read_col0:
        ldx #8
        jmp read_key

read_akey:
        ldx #(9*8-1)
k0:
        lda #14                 ; Write Column Register Number to PortA
        sta VIA_PORTA 
        ldy #$ff                ; Tell AY this is Register Number
        sty VIA_PCR            
        ldy #$dd                ; Clear CB2, as keeping it high hangs on some orics.
        sty VIA_PCR             ; Pitty, as all this code could be run only once, otherwise
        ldy #8                       
        lda kcol0,x             ; Write column mask to Port A(negative logic)
        sta VIA_PORTA
k1:     dex 
        dey
        tya
        bmi k2                  ; Select row on VIA Port B (bits 0-2)  
        sta VIA_PORTB
        lda #$fd
        sta VIA_PCR
        sty VIA_PCR
        lda VIA_PORTB           ; Read VIA Port B
        and #$08                ; Test bit 3 (PB3)
        beq k1                  ; next row
        lda kcol0,x
        rts
k2:     txa
        bne k0                  ; next column
        lda #0
        rts

read_key:
        jsr read_akey
        cmp pkey
        beq read_key
        sta pkey
        rts 


wait_space:
        lda #14                 ; Write Column Register Number to PortA
        sta VIA_PORTA 
        ldy #$ff                ; Tell AY this is Register Number
        sty VIA_PCR            
        ldy #$dd                ; Clear CB2, as keeping it high hangs on some orics.
        sty VIA_PCR             ; Pitty, as all this code could be run only once, otherwise
        ldy #8                       
        lda #$fe                ; Write column mask to Port A(negative logic)
        sta VIA_PORTA
        lda #4                  ; Select row on VIA Port B (bits 0-2) 
        sta VIA_PORTB
        lda #$fd
        sta VIA_PCR
        sty VIA_PCR
        lda VIA_PORTB           ; Read VIA Port B
        and #$08                ; Test bit 3 (PB3)
        beq k3                  ; not pressed!
        lda #' ' 
        rts
k3:     lda #0
        rts


;-------------------------------------------------------------
spriteshide:
        ldy #NB_SPRITES_TOTAL-1 ; Hide sprites available
clrsp:
        lda #$00
        sta REG_SPRITE_IND,y
        sta REG_SPRITE_XHI,y
        sta REG_SPRITE_XLO,y
        lda #200
        sta REG_SPRITE_Y,y
        dey
        bpl clrsp
        rts

;-------------------------------------------------------------
;  move the wave
vsynctask:
        ldy #NB_SPRITES-1       ; NR sprites
        ldx posx
-
        lda sine,x
        lsr
        sta REG_SPRITE_XLO,y
        inx
        inx
        inx
        inx
        inx
;        txa
;        adc #4
;        tax
;        clc
        dey
        bpl -
        inc posx

        ldy #NB_SPRITES-1       ; NR sprites
        ldx posy
--
        lda sine,x
        lsr
        sta REG_SPRITE_Y,y
        inx
        inx
        inx
        inx
        inx
;        txa
;        adc #4
;        tax
;        clc
        dey
        bpl --
        inc posy
        rts

;-------------------------------------------------------------
sprite8bits     
        lda #2                  ; command = transfer sprite
        sta REG_TCOMMAND 
        txa                     ; param = sprite id
        sta REG_TPARAMS
        lda #16
        sta REG_TPARAMS 
        lda #24
        sta REG_TPARAMS
        lda $54
        pha
        lda $55
        pha
        ldy #$00
sprite80:
        lda ($54),y
        sta REG_TDATA
        iny
        bne sprite80
        inc $55
sprite81:
        lda ($54),y
        sta REG_TDATA
        iny
        cpy #128
        bne sprite81
        pla 
        sta $55
        pla
        sta $54
        rts

;-------------------------------------------------------------
posx
!byte $00
posy
!byte $20

sine
!byte $80, $83, $86, $89, $8C, $90, $93, $96
!byte $99, $9C, $9F, $A2, $A5, $A8, $AB, $AE
!byte $B1, $B3, $B6, $B9, $BC, $BF, $C1, $C4
!byte $C7, $C9, $CC, $CE, $D1, $D3, $D5, $D8
!byte $DA, $DC, $DE, $E0, $E2, $E4, $E6, $E8
!byte $EA, $EB, $ED, $EF, $F0, $F1, $F3, $F4
!byte $F5, $F6, $F8, $F9, $FA, $FA, $FB, $FC
!byte $FD, $FD, $FE, $FE, $FE, $FF, $FF, $FF
!byte $FF, $FF, $FF, $FF, $FE, $FE, $FE, $FD
!byte $FD, $FC, $FB, $FA, $FA, $F9, $F8, $F6
!byte $F5, $F4, $F3, $F1, $F0, $EF, $ED, $EB
!byte $EA, $E8, $E6, $E4, $E2, $E0, $DE, $DC
!byte $DA, $D8, $D5, $D3, $D1, $CE, $CC, $C9
!byte $C7, $C4, $C1, $BF, $BC, $B9, $B6, $B3
!byte $B1, $AE, $AB, $A8, $A5, $A2, $9F, $9C
!byte $99, $96, $93, $90, $8C, $89, $86, $83
!byte $80, $7D, $7A, $77, $74, $70, $6D, $6A
!byte $67, $64, $61, $5E, $5B, $58, $55, $52
!byte $4F, $4D, $4A, $47, $44, $41, $3F, $3C
!byte $39, $37, $34, $32, $2F, $2D, $2B, $28
!byte $26, $24, $22, $20, $1E, $1C, $1A, $18
!byte $16, $15, $13, $11, $10, $0F, $0D, $0C
!byte $0B, $0A, $08, $07, $06, $06, $05, $04
!byte $03, $03, $02, $02, $02, $01, $01, $01
!byte $01, $01, $01, $01, $02, $02, $02, $03
!byte $03, $04, $05, $06, $06, $07, $08, $0A
!byte $0B, $0C, $0D, $0F, $10, $11, $13, $15
!byte $16, $18, $1A, $1C, $1E, $20, $22, $24
!byte $26, $28, $2B, $2D, $2F, $32, $34, $37
!byte $39, $3C, $3F, $41, $44, $47, $4A, $4D
!byte $4F, $52, $55, $58, $5B, $5E, $61, $64
!byte $67, $6A, $6D, $70, $74, $77, $7A, $7D

